# ---------------------------------------------------------------------------
# Streamlit Cloud secrets TEMPLATE
#
#   DO NOT COMMIT REAL VALUES. This file is a shape reference only.
#
# Where this goes on Streamlit Community Cloud:
#   App dashboard -> Settings -> Secrets -> paste TOML, then Save.
#   The app reads it at runtime via st.secrets. Nothing is written to the repo.
#
# BOTH entries below are REQUIRED. The app has no compiled-in default workbook
# on purpose: a silent fallback target is how an app ends up writing into the
# wrong sheet. With no spreadsheet_id the engine refuses to connect and says so.
# ---------------------------------------------------------------------------

# Required: the OK3D Shadow Copy workbook id.
# Take it from the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
# Use the SHADOW COPY id -- never the live trading sheet's.
spreadsheet_id = "1BIizam6JvfXW1YX6sxJS5pB4aKBj77Vdn09uvKmjMcg"

# Required: the service-account key, pasted as a TOML table.
# Copy every field from credentials.json verbatim -- the private_key must keep
# its "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" wrapper
# and its literal \n escapes.
[gcp_service_account]
type = "service_account"
project_id = "ok3d-stock-app"
private_key_id = "REPLACE_WITH_YOURS"
private_key = "-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOURS\n-----END PRIVATE KEY-----\n"
client_email = "ok3d-app-handler@ok3d-stock-app.iam.gserviceaccount.com"
client_id = "REPLACE_WITH_YOURS"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/ok3d-app-handler%40ok3d-stock-app.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
