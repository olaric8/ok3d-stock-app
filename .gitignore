# OK3D Stock App - ignored files

# --- Google service-account keys: never commit these ---
credentials.json
*service-account*.json
*.key.json

# --- Streamlit secrets: the SAME private key, in TOML form ---
# make-secrets-block.ps1 writes .streamlit/secrets.toml, and a local Streamlit
# run picks it up through st.secrets. It must never reach a repository.
secrets.toml
**/secrets.toml

# The template stays tracked on purpose -- it holds no real values.
!.streamlit/secrets.toml.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
verify-out.txt

# --- local scratch (pip/Streamlit temp redirected here) ---
.piptmp/

# --- exports produced by the app ---
*.log

# --- local git staging folder used by the push scripts ---
.stage-ok3d/

# --- personal access codes: never commit ---
access-codes.csv

# --- personal access codes: never commit ---
access-block.txt

# --- generated analysis output (reproducible from the scripts) ---
demand-clean.csv
minimum-stock-final.csv
minimum-stock-proposal.csv
opening-balance-fix-*.csv
import-preview-*.csv
